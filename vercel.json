{
  "version": 2,
  "buildCommand": "npm run build || true",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["agents/**", "agents-es.json", "public/**"] }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
